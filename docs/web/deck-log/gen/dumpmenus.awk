#  Dump the VOS coded menus from the deck-log engine's own tables, as JS.
#  These are 0-9 codes because that is what they are in the standard, so
#  a menu here is the standard and not a coarsening of it -- which is
#  also why not one character of them is retyped.
#  js_dq/js_sq live in docs/web/gen/jsonesc.awk, loaded with -f before
#  this file. The doubling must not happen in gsub's replacement string;
#  see the long note there.
function jq(s){ return js_sq(s) }
#  This dumper is loaded BEFORE screens.awk on the command line, so its
#  BEGIN block runs first.  screens.awk carries the tool's own dispatch
#  in a BEGIN block that would otherwise print over the dump, so the
#  output goes to a named file and screens.awk's stdout is discarded.
BEGIN{
  menus_init()
  printf "// Generated by docs/web/deck-log/gen/make-decklog-web.sh -- DO NOT EDIT.\n" > OUTF
  printf "// The VOS coded menus, dumped from src/decklog/screens.awk, and the\n" > OUTF
  printf "// engine checklist, dumped from src/decklog/30-ui.sh.\n" > OUTF
  printf "'use strict';\n" > OUTF
  printf "var MENUS = {\n" > OUTF
  for(i=1;i<=MN_N;i++){
    k = MN_K[i]
    printf "  %s: { title: '%s', opts: [", k, jq(MN_T[k]) > OUTF
    n = split(MN_O[k], a, ";")
    for(j=1;j<=n;j++){
      p = index(a[j], "=")
      printf "%s['%s', '%s']", (j>1 ? ", " : ""), jq(substr(a[j],1,p-1)), jq(substr(a[j],p+1)) > OUTF
    }
    printf "] },\n" > OUTF
  }
  printf "};\n" > OUTF
  printf "var MENU_ORDER = [" > OUTF
  for(i=1;i<=MN_N;i++) printf "%s'%s'", (i>1 ? ", " : ""), MN_K[i] > OUTF
  printf "];\n" > OUTF
}
