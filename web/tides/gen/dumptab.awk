# Dump the UTide-derived constituent tables verbatim, as JS.
# The strings are never retyped: they are printed from the engine's own
# runtime values, so a typo here is impossible by construction.
BEGIN{
  tide_tables_init()
  printf "// Generated by work-tides/dumptab.awk from src/tides/tables.awk\n"
  printf "// Constituent, satellite and shallow-water tables, as carried by UTide v1p0.\n"
  printf "// DO NOT EDIT.  Regenerate instead.\n"
  printf "'use strict';\n"
  printf "var TT_CONST = %c%s%c;\n", 39, TT_CONST, 39
  printf "var TT_SAT = %c%s%c;\n", 39, TT_SAT, 39
  printf "var TT_SHAL = %c%s%c;\n", 39, TT_SHAL, 39
  printf "if (typeof module !== 'undefined') module.exports = { TT_CONST:TT_CONST, TT_SAT:TT_SAT, TT_SHAL:TT_SHAL };\n"
}
