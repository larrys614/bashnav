  "39|Zubenelgenubi|222.719638|-16.041778|-105.7|-69.0|2.75;40|Kochab|222.676360|74.155505|-32.3|11.9|2.07;" \
  "41|Alphecca|233.671951|26.714693|120.4|-89.4|2.22;42|Antares|247.351920|-26.432003|-10.2|-23.2|1.06;" \
